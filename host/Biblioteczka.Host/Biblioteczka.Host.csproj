<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Biblioteczka</AssemblyName>
    <RootNamespace>Biblioteczka.Host</RootNamespace>
    <Product>Biblioteczka – Bookshelf Wallpaper</Product>
    <Copyright>GPL-3.0-or-later</Copyright>
    <!-- LibraryImport generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The WebView2 package also ships a WPF assembly we do not use; its WindowsBase reference conflicts harmlessly. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <PropertyGroup>
    <ApplicationIcon>Assets\biblioteczka.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\biblioteczka.ico" LogicalName="biblioteczka.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Biblioteczka.Host.Tests" />
  </ItemGroup>

</Project>
