<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest for the Microsoft Store package. tools/build-msix.ps1 fills the double-brace values;
     the identity values come from Partner Center (Product identity) once the name is reserved. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="{{IdentityName}}" Publisher="{{Publisher}}" Version="{{Version}}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Biblioteczka – Bookshelf Wallpaper</DisplayName>
    <PublisherDisplayName>{{PublisherDisplayName}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 11 23H2 or later. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22631.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="pl-PL" />
  </Resources>

  <Applications>
    <Application Id="Biblioteczka" Executable="Biblioteczka.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Biblioteczka"
        Description="Your read books on an interactive bookshelf wallpaper."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Start with Windows, on by default; the user controls it in Settings → Apps → Startup. -->
        <desktop:Extension Category="windows.startupTask" Executable="Biblioteczka.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="BiblioteczkaStartup" Enabled="true" DisplayName="Biblioteczka" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Book catalogs and covers. The local server listens only on 127.0.0.1. -->
    <Capability Name="internetClient" />
    <!-- Desktop app: draws the wallpaper behind the desktop icons and runs its Node.js helper. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
